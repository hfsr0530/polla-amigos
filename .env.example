# ── Base de datos ────────────────────────────────────────────────────────────
# Producción: Neon (Postgres serverless, gratis) → https://neon.tech
#   1. Crea un proyecto en Neon
#   2. Copia el "connection string" (botón Connect, incluye ?sslmode=require)
#   3. Pégalo aquí
# Sin DATABASE_URL la app usa PGlite (Postgres embebido) en ./data/pglite —
# perfecto para desarrollo local, no para producción.
DATABASE_URL=

# ── Proveedor de resultados en vivo ─────────────────────────────────────────
# "espn"           → API pública de ESPN: live scores rápidos, sin key (default).
#                    El fixture completo se siembra solo desde worldcup26.
# "football-data"  → https://www.football-data.org (estable, key gratis,
#                    marcadores con un pequeño delay en el plan free)
# "worldcup26"     → https://worldcup26.ir (comunitaria, sin key)
LIVESCORE_PROVIDER=espn

# API key gratuita de football-data.org (solo si usas ese proveedor)
# Regístrate en https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# ── Sesiones ─────────────────────────────────────────────────────────────────
# Secreto para firmar las cookies de sesión. Genera uno con:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-por-uno-aleatorio

# Pon "true" SOLO si sirves la app por HTTPS (Vercel, túnel TLS, etc.)
COOKIE_SECURE=false

# ── Zona horaria para agrupar los partidos por día ──────────────────────────
# DISPLAY_TZ=America/Bogota
